generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  TECNICO
  LEITOR
}

model User {
  id                          String    @id @default(cuid())
  firstName                   String
  lastName                    String?
  email                       String    @unique
  passwordHash                String
  securityQuestion            String?
  securityAnswerHash          String?
  securityRecoveryAttempts    Int       @default(0)
  securityRecoveryLockedUntil DateTime?
  role                        Role      @default(LEITOR)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  sessions       Session[]
  passwordResets PasswordReset[]
  racks          Rack[]
  switches       Switch[]
  patchPanels    PatchPanel[]
  networkPoints  NetworkPoint[]
  bomItems       BomItem[]
  bomSettings    BomSettings[]
  locations      InfrastructureLocation[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  rememberMe Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model InfrastructureLocation {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, normalizedName])
  @@index([ownerId])
  @@map("infrastructure_locations")
}

// ---------- Inventario de rede (Prioridade 2 — a implementar) ----------

enum CableCategory {
  CAT5E
  CAT6
  CAT6A
  FIBRA_OM3
  FIBRA_OM4
  FIBRA_OS2
}

enum TestResult {
  PASS
  FAIL
  PENDENTE
}

model Rack {
  id        String   @id @default(cuid())
  ownerId   String?
  name      String
  location  String?
  createdAt DateTime @default(now())

  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  switches    Switch[]
  patchPanels PatchPanel[]

  @@index([ownerId])
  @@map("racks")
}

model Switch {
  id        String       @id @default(cuid())
  ownerId   String?
  name      String
  model     String?
  portCount Int
  rackId    String?
  owner     User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rack      Rack?        @relation(fields: [rackId], references: [id])
  ports     SwitchPort[]

  @@index([ownerId])
  @@map("switches")
}

model SwitchPort {
  id           String        @id @default(cuid())
  switchId     String
  number       Int
  switch       Switch        @relation(fields: [switchId], references: [id], onDelete: Cascade)
  networkPoint NetworkPoint?

  @@unique([switchId, number])
  @@map("switch_ports")
}

model PatchPanel {
  id        String           @id @default(cuid())
  ownerId   String?
  name      String
  portCount Int
  rackId    String?
  owner     User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rack      Rack?            @relation(fields: [rackId], references: [id])
  ports     PatchPanelPort[]

  @@index([ownerId])
  @@map("patch_panels")
}

model PatchPanelPort {
  id           String        @id @default(cuid())
  patchPanelId String
  number       Int
  patchPanel   PatchPanel    @relation(fields: [patchPanelId], references: [id], onDelete: Cascade)
  networkPoint NetworkPoint?

  @@unique([patchPanelId, number])
  @@map("patch_panel_ports")
}

model NetworkPoint {
  id               String        @id @default(cuid())
  ownerId          String?
  code             String // identificador impresso na etiqueta
  location         String
  cableCategory    CableCategory
  patchPanelPortId String?       @unique
  switchPortId     String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  owner          User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  patchPanelPort PatchPanelPort?     @relation(fields: [patchPanelPortId], references: [id])
  switchPort     SwitchPort?         @relation(fields: [switchPortId], references: [id])
  certifications CertificationTest[]

  @@unique([ownerId, code])
  @@index([ownerId])
  @@map("network_points")
}

model CertificationTest {
  id             String     @id @default(cuid())
  networkPointId String
  result         TestResult @default(PENDENTE)
  performedAt    DateTime   @default(now())
  performedBy    String?
  notes          String?

  networkPoint NetworkPoint @relation(fields: [networkPointId], references: [id], onDelete: Cascade)

  @@index([networkPointId])
  @@map("certification_tests")
}

// ---------- BOM — lista de materiais (Prioridade 4 — a implementar) ----------

model BomItem {
  id            String   @id @default(cuid())
  ownerId       String?
  name          String
  unit          String
  quantity      Float
  estimatedCost Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("bom_items")
}

model BomSettings {
  id            String  @id @default(cuid())
  userId        String? @unique
  marginPercent Float   @default(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bom_settings")
}
