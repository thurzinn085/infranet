# Banco de dados (PostgreSQL — recomendado: Neon, free tier, serverless)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo usado para assinar os tokens de sessao (gerar uma string aleatoria longa)
AUTH_SECRET="troque-por-uma-string-aleatoria-longa-e-unica"

# URL publica da aplicacao (usada nos links dos e-mails)
APP_URL="http://localhost:3000"

# Envio de e-mail (recomendado: Resend, free tier)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
EMAIL_FROM="InfraNet <no-reply@seudominio.com>"
